# Role: "hub" serves the dashboard, owns the node registry and service links,
# and aggregates every agent. "agent" reports only its own machine.
NODE_ROLE=hub

# Server
PORT=3001
NODE_ENV=development

# Identity in the fleet. Both default to this machine's hostname.
# NODE_ID=pi5
# NODE_NAME=Raspberry Pi 5

# Database (hub only; agents open none)
DB_PATH=./data/homelab.db

# Logging (trace, debug, info, warn, error, fatal, silent)
LOG_LEVEL=info

# Shared secret for /api and WebSocket upgrades. Unset disables authentication,
# which is the sensible default on a trusted LAN. Set it on an agent that is
# reachable more widely, and enter the same value on the hub when registering
# that node.
# AGENT_TOKEN=change-me

# Restrict CORS to specific origins (comma-separated). Unset allows all.
# CORS_ORIGIN=http://localhost:3000,http://192.168.1.100:1781

# Host access paths (used when running in Docker)
HOST_PROC=/proc
HOST_ROOT=/host
# HOST_SYS=/sys

# Cap on processes returned by the process list
# PROCESS_LIMIT=150

# How long the hub waits on an agent before treating a call as failed
# AGENT_TIMEOUT_MS=8000
